import React, { useState } from 'react';

function Student(props) {
  const [count, setCount] = useState(0);

  return (
    <div>
      <h2>Student Name: {props.name}</h2>
      <p>Count: {count}</p>
      <button onClick={() => setCount(count + 1)}>
        Increment
      </button>
    </div>
  );
}

function App() {
  return <Student name="Sai Balaji" />;
}

export default App;